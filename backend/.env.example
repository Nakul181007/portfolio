# Use a persistent PostgreSQL database for deployment.
# Local development can continue using SQLite.
DATABASE_URL=sqlite:///./portfolio.db

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (optional — leave blank to disable email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com
